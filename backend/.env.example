# Copy this file to .env and fill in your keys. .env is gitignored, so it
# never gets committed.

# Powers /ask's grounding source (see search.py) — live web search via
# Tavily (tavily.com), biased toward IMD/NDMA domains. Has a free tier
# (~1,000 searches/month). Without this set, /ask still works — it just falls
# back to Open-Meteo-only grounding, same as before this source existed.
TAVILY_API_KEY=

# The one shared password for the "Emergency official" admin capability
# (issuing/advancing alerts) — see auth.py. Change this before any real
# deployment; the code falls back to "changeme-admin" if unset.
ADMIN_PASSWORD=changeme-admin
