# Copy this file to .env and fill in your key. .env is gitignored, so it
# never gets committed. The Anthropic SDK (used in ask.py) reads
# ANTHROPIC_API_KEY automatically once python-dotenv loads it into the
# environment — no code changes needed after you set this.
ANTHROPIC_API_KEY=

# The one shared password for the "Emergency official" admin capability
# (issuing/advancing alerts) — see auth.py. Change this before any real
# deployment; the code falls back to "changeme-admin" if unset.
ADMIN_PASSWORD=changeme-admin
